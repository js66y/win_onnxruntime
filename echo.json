{
  "llm": {
    "model_dir": "third_party/Qwen3-0.6B-ONNX-INT4-CPU",
    "max_length": 4096,
    "do_sample": true,
    "temperature": 0.7,
    "top_p": 0.8,
    "disable_thinking": true
  },
  "asr": {
    "model": "models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17/model.int8.onnx",
    "tokens": "models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17/tokens.txt",
    "num_threads": 2,
    "language": "auto",
    "use_itn": true
  },
  "tts": {
    "model": "models/vits-melo-tts-zh_en/model.onnx",
    "lexicon": "models/vits-melo-tts-zh_en/lexicon.txt",
    "tokens": "models/vits-melo-tts-zh_en/tokens.txt",
    "dict_dir": "models/vits-melo-tts-zh_en/dict",
    "num_threads": 4,
    "speaker_id": 0,
    "speed": 1.0
  },
  "vad": {
    "model": "models/silero_vad.onnx",
    "threshold": 0.5,
    "min_silence_seconds": 0.3,
    "min_speech_seconds": 0.25,
    "max_speech_seconds": 20.0,
    "sample_rate": 16000
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8080,
    "web_root": "web",
    "db_path": "data/echo.db"
  },
  "active_role": "echo",
  "roles": [
    {
      "id": "echo",
      "name": "回声",
      "system_prompt": "你是\"回声\"(Echo), 一个完全离线运行的中文语音助手。用中文回答, 保持简短、口语化, 除非用户要求详细说明。"
    },
    {
      "id": "tutor",
      "name": "耐心老师",
      "system_prompt": "你是一位耐心的中文老师。讲解要分步骤、举例子, 语气温和鼓励。回答尽量控制在一小段内。"
    },
    {
      "id": "coder",
      "name": "编程搭档",
      "system_prompt": "你是务实的编程搭档。优先给可运行的关键代码与简洁解释, 少说空话。默认用中文交流。"
    }
  ]
}
